# ============================================
# Containerized ML Prediction API
# Environment Variables Template
# ============================================

# Path to the pre-trained Keras model artifact
MODEL_PATH=models/my_classifier.h5

# Logging level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application port (default: 8000)
APP_PORT=8000

# Application environment (development, staging, production)
APP_ENV=development
